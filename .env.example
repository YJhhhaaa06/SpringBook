# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略，不会进仓库）
# 宿主机映射端口：本机 3306 常被原生 mysqld 占用，默认 3307
MYSQL_PORT=3307
APP_PORT=8080

# 「本机就用容器跑应用」：取消下面这行的注释后，docker compose up -d / stop / down
# 都会同时作用于 mysql 和 app，不必每条命令都写 --profile full。
# 如果你习惯用宿主机 JDK（./mvnw spring-boot:run）跑应用，就不要打开它，否则两者会抢 8080。
# COMPOSE_PROFILES=full

# 必填：JWT 签名密钥，至少 32 字节。留空时 app 容器会立即退出并打印原因（fail-fast）
# 生成示例：openssl rand -base64 48
JWT_SECRET=jwt-token-jwt-token-jtw-token-jwt-token

# 首次启动时创建的管理员口令，默认 admin123，登录后请立即修改
ADMIN_PASSWORD=admin123
