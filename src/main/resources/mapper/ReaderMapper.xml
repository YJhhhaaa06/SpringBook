<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.github.yjhhhaaa06.springbook.reader.mapper.ReaderMapper">

    <sql id="allColumns">
        id, name, phone, status, created_at, updated_at
    </sql>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO readers (name, phone)
        VALUES (#{name}, #{phone})
    </insert>

    <select id="findById" resultType="io.github.yjhhhaaa06.springbook.reader.domain.Reader">
        SELECT <include refid="allColumns"/>
        FROM readers
        WHERE id = #{id}
    </select>

    <select id="findByPhone" resultType="io.github.yjhhhaaa06.springbook.reader.domain.Reader">
        SELECT <include refid="allColumns"/>
        FROM readers
        WHERE phone = #{phone}
    </select>

    <select id="lockById" resultType="io.github.yjhhhaaa06.springbook.reader.domain.Reader">
        SELECT <include refid="allColumns"/>
        FROM readers
        WHERE id = #{id}
        FOR UPDATE
    </select>

    <update id="updateStatus">
        UPDATE readers
        SET status = #{status}
        WHERE id = #{id}
    </update>

    <update id="update">
        UPDATE readers
        SET name = #{name},
            phone = #{phone}
        WHERE id = #{id}
    </update>

    <sql id="keywordFilter">
        <where>
            <if test="keyword != null and keyword != ''">
                AND (name LIKE CONCAT('%', #{keyword}, '%')
                  OR phone LIKE CONCAT('%', #{keyword}, '%'))
            </if>
        </where>
    </sql>

    <select id="countByKeyword" resultType="long">
        SELECT COUNT(*)
        FROM readers
        <include refid="keywordFilter"/>
    </select>

    <select id="listByKeyword" resultType="io.github.yjhhhaaa06.springbook.reader.domain.Reader">
        SELECT <include refid="allColumns"/>
        FROM readers
        <include refid="keywordFilter"/>
        ORDER BY id ASC
        LIMIT #{offset}, #{size}
    </select>

</mapper>
